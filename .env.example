# ============================================================
# reclu.cl — Variables de entorno
# Copia este archivo a .env.local y completa los valores.
# ============================================================

# ---- Supabase (REQUERIDO) ----
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://<tu-proyecto>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key-publica>"

# Solo para edge functions y scrapers (NUNCA exponer en el cliente)
SUPABASE_SERVICE_ROLE_KEY="<service-role-key-secreta>"

# ---- OpenRouter (REQUERIDO para resúmenes AI y asistente de chat) ----
# https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-..."
# Modelo barato recomendado (configurable)
OPENROUTER_MODEL="google/gemini-2.0-flash-001"

# ---- Resend (REQUERIDO para emails de alertas) ----
# https://resend.com/api-keys
RESEND_API_KEY="re_..."
EMAIL_FROM="reclu.cl <alertas@reclu.cl>"

# ---- Sitio ----
# URL pública (usado en OAuth redirects y emails)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Telegram (frente F4). Crea el bot con @BotFather; sin estos valores el
# canal Telegram se omite sin errores y solo se envía correo.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""

# URL de la edge function send-alerts (cron de Vercel la llama; opcional).
SEND_ALERTS_URL=""

# En producción: https://reclu.cl
