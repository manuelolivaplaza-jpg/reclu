# ============================================================
# reclu.cl — Variables de entorno
# Copia este archivo a .env.local y completa los valores.
# ============================================================

# ---- Supabase (REQUERIDO) ----
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://<tu-proyecto>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key-publica>"

# Solo para edge functions y scrapers (NUNCA exponer en el cliente)
SUPABASE_SERVICE_ROLE_KEY="<service-role-key-secreta>"

# ---- OpenRouter (REQUERIDO para resúmenes AI y asistente de chat) ----
# https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-..."
# Modelo barato recomendado (configurable)
OPENROUTER_MODEL="google/gemini-2.0-flash-001"

# ---- Resend (REQUERIDO para emails de alertas) ----
# https://resend.com/api-keys
RESEND_API_KEY="re_..."
EMAIL_FROM="reclu.cl <alertas@reclu.cl>"

# ---- Sitio ----
# URL pública del sitio (sitemap, canonical, OG, robots, OAuth redirects).
# La app se publicará en su propia dirección (p. ej. https://app.reclu.cl).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Scrapers (se corren aparte, NO en el build) ----
# Benchmarks y precios usan las mismas credenciales de Supabase de arriba
# (SUPABASE_URL = NEXT_PUBLIC_SUPABASE_URL para los scrapers en Python).
# scrapers/benchmarks.py: S&P 500 (^GSPC) e IPSA (^IPSA) desde Yahoo Finance,
# sin API key. Símbolos alternativos:
#   BENCHMARK_SYMBOLS="^GSPC,^IPSA"
# Días de historia a descargar (default 730):
#   BENCHMARK_DAYS=730

# ---- Pipeline de alertas (REQUERIDO para Vercel Cron) ----
# Secreto compartido que Vercel Cron envía en el header
# `Authorization: Bearer <CRON_SECRET>` al llamar GET /api/run-pipeline.
# SIN esta variable el endpoint responde 503 y NO ejecuta nada (seguridad).
# Genera uno con: openssl rand -hex 32
CRON_SECRET=""

# ---- Analítica (OPCIONAL, sin cookies) ----
# Dominio registrado en Plausible. Si queda vacío, no se carga analítica.
# Vercel Analytics se habilita aparte desde el dashboard de Vercel.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

