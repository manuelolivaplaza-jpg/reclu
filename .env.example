# ============================================================
# reclu.cl — Variables de entorno
# Copia este archivo a .env.local y completa los valores.
# ============================================================

# ---- Supabase (REQUERIDO) ----
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://<tu-proyecto>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key-publica>"

# Solo para edge functions y scrapers (NUNCA exponer en el cliente)
SUPABASE_SERVICE_ROLE_KEY="<service-role-key-secreta>"

# ---- OpenRouter (REQUERIDO para resúmenes AI y asistente de chat) ----
# https://openrouter.ai/keys
# Sin API key Y modelo la IA queda deshabilitada (503). No hay modelo por defecto:
# elige uno en https://openrouter.ai/models y pégalo aquí.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
# Sal opcional para hashear la IP del chat anónimo. Cualquier string largo.
CHAT_RATE_SALT=""

# ---- Resend (REQUERIDO para emails de alertas) ----
# https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="reclu.cl <alertas@reclu.cl>"

# ---- Sitio ----
# URL pública del sitio (sitemap, canonical, OG, robots, OAuth redirects).
# La app se publicará en su propia dirección (p. ej. https://app.reclu.cl).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Scrapers (se corren aparte, NO en el build) ----
# Benchmarks y precios usan las mismas credenciales de Supabase de arriba
# (SUPABASE_URL = NEXT_PUBLIC_SUPABASE_URL para los scrapers en Python).
# scrapers/benchmarks.py: S&P 500 (^GSPC) e IPSA (^IPSA) desde Yahoo Finance,
# sin API key. Símbolos alternativos:
#   BENCHMARK_SYMBOLS="^GSPC,^IPSA"
# Días de historia a descargar (default 730):
#   BENCHMARK_DAYS=730
# InfoProbidad: 0 = no consultar nombres de autoridades (default).
# Pasar a 1 solo después de revisión legal. Esta versión no guarda nombres
# aunque el flag esté en 1: no hay ficha por persona.
INFOPROBIDAD_NOMBRES=0

# ---- Pipeline de alertas (REQUERIDO para Vercel Cron) ----
# Secreto compartido que Vercel Cron envía en el header
# `Authorization: Bearer <CRON_SECRET>` al llamar GET /api/run-pipeline.
# SIN esta variable el endpoint responde 503 y NO ejecuta nada (seguridad).
# Genera uno con: openssl rand -hex 32
CRON_SECRET=""

# ---- Analítica (OPCIONAL, sin cookies) ----
# Dominio registrado en Plausible. Si queda vacío, no se carga analítica.
# Vercel Analytics se habilita aparte desde el dashboard de Vercel.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# Telegram (frente F4). Crea el bot con @BotFather; sin estos valores el
# canal Telegram se omite sin errores y solo se envía correo.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""

# URL de la edge function send-alerts (cron de Vercel la llama; opcional).
SEND_ALERTS_URL=""


# ---- Pagos / suscripciones (F2) ----
# Proveedor activo: flow | mercadopago | mock.
# FAIL CLOSED: si eliges flow o mercadopago y faltan claves, el checkout
# responde 503. No cae a mock. Sin esta variable, en desarrollo el default es mock.
# mock está prohibido si VERCEL_ENV=production o PAYMENT_MODE=production.
PAYMENT_PROVIDER="mock"
# sandbox (pruebas) | production (cobros reales)
PAYMENT_MODE="sandbox"
# Solo permite mock cuando NODE_ENV=production Y VERCEL_ENV no es production
# (un staging). En Vercel production se ignora. Déjalo vacío.
ALLOW_MOCK_PAYMENTS=""

# Flow.cl (https://www.flow.cl — Crear cuenta → API)
# Sandbox: https://sandbox.flow.cl | Producción: https://www.flow.cl
FLOW_API_KEY=""
FLOW_SECRET_KEY=""
# Ids de los planes de suscripción creados en el portal de Flow
# (Planes → crear plan con periodicidad mensual/anual y los montos de reclu):
FLOW_PLAN_PRO_MENSUAL=""
FLOW_PLAN_PRO_ANUAL=""
FLOW_PLAN_ELITE_MENSUAL=""
FLOW_PLAN_ELITE_ANUAL=""

# Mercado Pago (https://www.mercadopago.cl/developers/panel)
MP_ACCESS_TOKEN=""
# Clave secreta de webhooks: Tus integraciones → Webhooks → Configurar
MP_WEBHOOK_SECRET=""
# Ids de los planes creados con POST /preapproval_plan:
MP_PREAPPROVAL_PLAN_PRO_MENSUAL=""
MP_PREAPPROVAL_PLAN_PRO_ANUAL=""
MP_PREAPPROVAL_PLAN_ELITE_MENSUAL=""
MP_PREAPPROVAL_PLAN_ELITE_ANUAL=""

# ---- Afiliados (M5) — APAGADO por defecto; requiere revisión legal/CMF ----
# "true" activa el componente broker-affiliate (enlaces de corredoras).
NEXT_PUBLIC_AFFILIATES_ENABLED="false"

# ---- Publicación en redes y newsletter (F17/F18) — APAGADO por defecto ----
# preview (defecto) prepara borradores; draft no envía; live envía si el canal está activo.
PUBLISH_MODE="preview"
# Cada canal envía solo con su flag en "true" y el borrador aprobado.
PUBLISH_X_ENABLED="false"
PUBLISH_TELEGRAM_ENABLED="false"
PUBLISH_NEWSLETTER_ENABLED="false"

# X API v2 (OAuth 1.0a): credenciales de app y de usuario para POST /2/tweets.
X_API_KEY=""
X_API_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_SECRET=""
# Bearer app-only: solo para lecturas; no sirve para publicar.
X_BEARER_TOKEN=""

# Canal de Telegram para publicaciones (@usuario o -100...); requiere TELEGRAM_BOT_TOKEN.
TELEGRAM_CHANNEL_ID=""
# Remitente del newsletter; sin RESEND_API_KEY no se envía la confirmación.
NEWSLETTER_FROM=""

# ---- Administración y funciones apagadas por defecto ----
# Emails separados por coma con acceso a /admin (requireAdmin); vacío = nadie.
ADMIN_EMAILS=""
# Comunidad de creadores: exige revisión legal antes de encender (Ley Fintec 21.521).
COMMUNITY_ENABLED="false"
# Programa de referidos: solo "true" enciende la cookie y la recompensa.
REFERRALS_ENABLED="false"
# Patrocinios rotulados: el servidor usa SPONSORS_ENABLED y el componente público NEXT_PUBLIC_SPONSORS_ENABLED.
SPONSORS_ENABLED="false"
NEXT_PUBLIC_SPONSORS_ENABLED="false"

# ---- API pública de datos (F53/F54) — APAGADA por defecto ----
# Solo el valor exacto "true" habilita /api/v1/* y la creación de claves en
# Ajustes → API. Cualquier otro valor (o su ausencia) responde 503.
# Los datasets de funcionarios de EE.UU. nunca se exponen por la API
# (5 U.S.C. § 13107).
API_PUBLIC_ENABLED="false"

# ---- Mi portafolio e impacto de noticias (F58+) - APAGADO por defecto ----
# Solo el valor exacto "true" enciende cada funcion (mismo criterio que
# COMMUNITY_ENABLED y API_PUBLIC_ENABLED).
MY_PORTFOLIO_ENABLED="false"
# NEWS_IMPACT_ENABLED también habilita las etapas de noticias (scrapers/stages/news_*.py).
NEWS_IMPACT_ENABLED="false"

# ---- Importación de cartera desde una captura (F79) - APAGADO por defecto ----
# Solo el valor exacto "true" habilita POST /api/holdings/image y muestra el
# botón "Subir captura" en /compare y /mi-portafolio.
PORTFOLIO_IMAGE_IMPORT_ENABLED="false"
# Modelo de VISIÓN de OpenRouter para leer la captura. SIN valor por defecto:
# si falta, la ruta responde 503 con un mensaje claro. Reusa OPENROUTER_API_KEY.
# Ejemplos: "google/gemini-2.5-flash", "openai/gpt-4.1-mini".
# No uses modelos ":free": pueden retener o entrenar con los datos.
OPENROUTER_VISION_MODEL=""

# ---- D35: producción ----
# "false" apaga el checkout (planes visibles, botón deshabilitado, POST /api/billing/checkout -> 503).
CHECKOUT_ENABLED=
# "false" impide caer a datos de demo si la DB está vacía (en VERCEL_ENV=production nunca se cae a demo).
DEMO_FALLBACK=
# Tope de llamadas de la IA de impacto de noticias (opcional).
IMPACT_MAX_CALLS=
# "true" muestra el aviso de instalar la PWA.
NEXT_PUBLIC_PWA_INSTALL_PROMPT=
# Scrapers: tope de símbolos de precios (default 1500) y envío de alertas de compra/venta (apagado).
# PRICES_MAX_SYMBOLS
# TRADE_ALERTS_SEND_ENABLED

# ---- D36: caché de lecturas públicas ----
# Secreto para POST /api/revalidate (Authorization: Bearer <valor>), que invalida
# la caché de 1 h al terminar el pipeline. Mínimo 16 caracteres; sin él la ruta
# responde 503 y la caché expira sola. Genera uno con: openssl rand -hex 32
# El workflow de scrapers lo lee del secret REVALIDATE_SECRET de GitHub.
REVALIDATE_SECRET=

# ---- Feed privado Maverlang (vía B) — APAGADO por defecto ----
# Solo el valor exacto "true" exporta y firma el feed al terminar el
# pipeline. Cualquier otro valor (o su ausencia) no hace nada.
# Las claves reales de staging y producción las configura Andamio con
# el sí de Manu. No generes claves aquí ni las pegues en este archivo.
FRACCION_FEED_EXPORT_ENABLED="false"
# PEM PKCS#8 Ed25519 (saltos como \n), o semilla hex/base64 de 32 bytes.
FRACCION_FEED_SIGNING_KEY=
# Identificador público de la clave (lo guarda Maverlang junto a la pública).
FRACCION_FEED_KEY_ID=
# Directorio local de salida (default: scrapers/data/maverlang-feed).
FRACCION_FEED_OUTPUT_DIR=
# Subida opcional de los JSON a un host privado (PUT {url}/{path}).
FRACCION_FEED_UPLOAD_URL=
FRACCION_FEED_UPLOAD_TOKEN=
# Ping a Maverlang al terminar (Authorization: Bearer). Si faltan, se
# omite el ping con una advertencia; no se reintenta en bucle.
MAVERLANG_REVALIDATE_URL=
MAVERLANG_REVALIDATE_SECRET=
